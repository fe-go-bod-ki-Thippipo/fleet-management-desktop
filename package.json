{
  "name": "fleet-machinery-desktop",
  "version": "0.1.2",
  "description": "Offline-first Fleet & Machinery Management Desktop",
  "main": "src/main/main.js",
  "private": true,
  "author": "Fleet & Machinery Management Project",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "th.co.ngantavee.fleetdesktop",
    "productName": "Fleet & Machinery Desktop",
    "asar": true,
    "npmRebuild": true,
    "files": [
      "index.html",
      "src/**/*",
      "database/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "Fleet-Machinery-Desktop-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fleet & Machinery Desktop",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Fleet-Machinery-Desktop-${version}-Portable-${arch}.${ext}"
    }
  }
}
